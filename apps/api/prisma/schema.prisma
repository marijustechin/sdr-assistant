// Prisma schema for the SDR Assistant API.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ResearchStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  INTERRUPTED
}

model Product {
  id                  String     @id @default(cuid())
  name                String
  description         String     @default("")
  possibleSearchTerms String[]   @default([])
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  research            Research[]

  @@map("products")
}

model Research {
  id              String         @id @default(cuid())
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  country         String
  status          ResearchStatus @default(QUEUED)
  stage           String?
  result          Json?
  error           String?
  lastHeartbeatAt DateTime?
  executionToken  String?
  executionLeaseUntil DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  stage01Result   ResearchStage01?
  stage02Result   ResearchStage02?
  stage03Result   ResearchStage03?

  @@map("researches")
}

/// Stage 01 result for one research job.
model ResearchStage01 {
  id                 String   @id @default(cuid())
  jobId              String   @unique
  job                Research @relation(fields: [jobId], references: [id], onDelete: Cascade)
  identifiedProduct  Json
  preparedCandidates Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("research_stage_01_results")
}

/// Full stage 02 result for one research job.
model ResearchStage02 {
  id        String   @id @default(cuid())
  jobId     String   @unique
  job       Research @relation(fields: [jobId], references: [id], onDelete: Cascade)
  result    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("research_stage_02_results")
}

/// Stage 03 result and resumable progress for one research job.
model ResearchStage03 {
  id            String   @id @default(cuid())
  jobId         String   @unique
  job           Research @relation(fields: [jobId], references: [id], onDelete: Cascade)
  criteria      Json?
  promptVersion String?
  /// Cumulative per-page decisions: every a, b, none, language exclusion and error.
  decisions     Json     @default("[]")
  decidedPages  Int      @default(0)
  errorPages    Int      @default(0)
  /// 03.2 result built from all final decisions; null until the first checkpoint.
  result        Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("research_stage_03_results")
}

/// Transport security of one mail connection. Unencrypted authentication is
/// deliberately not representable.
enum EmailSecurityMode {
  TLS
  STARTTLS
}

/// Outcome of the last saved-configuration connection test for one mail
/// protocol. `NOT_TESTED` also means that a configuration change invalidated an
/// earlier result.
enum EmailVerificationStatus {
  NOT_TESTED
  VERIFIED
  FAILED
}

/// One independently configurable mailbox. SMTP and IMAP credentials are
/// stored separately as authenticated ciphertext (AES-256-GCM, key from
/// `EMAIL_ACCOUNT_ENCRYPTION_KEY`); no plaintext credential is ever persisted
/// or returned. The verification fields below are independent per protocol:
/// changing one protocol's configuration resets only that protocol's result.
/// There is intentionally no relation to research yet.
model EmailAccount {
  id           String  @id @default(cuid())
  name         String
  senderName   String
  emailAddress String
  enabled      Boolean @default(true)

  smtpHost              String
  smtpPort              Int
  smtpSecurity          EmailSecurityMode
  smtpUsername          String
  smtpPasswordEncrypted String

  imapHost              String
  imapPort              Int
  imapSecurity          EmailSecurityMode
  imapUsername          String
  imapPasswordEncrypted String

  /// Result of the last SMTP connection test, never of a sending attempt.
  smtpVerificationStatus      EmailVerificationStatus @default(NOT_TESTED)
  smtpLastCheckedAt           DateTime?
  smtpVerificationFailureCode String?

  /// Result of the last IMAP connection test, never of a mailbox operation.
  imapVerificationStatus      EmailVerificationStatus @default(NOT_TESTED)
  imapLastCheckedAt           DateTime?
  imapVerificationFailureCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_accounts")
}

/// One stored value per registered setting key. The code registry owns the
/// schema and the default; this table only holds values that were explicitly
/// saved. `value` stays JSON so new setting types need no migration.
model Setting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}
