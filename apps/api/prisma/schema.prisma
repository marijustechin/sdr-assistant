// Prisma schema for the SDR Assistant API.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ResearchStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  INTERRUPTED
}

model Product {
  id                  String     @id @default(cuid())
  name                String
  description         String     @default("")
  possibleSearchTerms String[]   @default([])
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  research            Research[]

  @@map("products")
}

model Research {
  id              String         @id @default(cuid())
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  country         String
  status          ResearchStatus @default(QUEUED)
  stage           String?
  result          Json?
  error           String?
  lastHeartbeatAt DateTime?
  executionToken  String?
  executionLeaseUntil DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  stage01Result   ResearchStage01?
  stage02Result   ResearchStage02?
  stage03Result   ResearchStage03?
  leadQualificationRuns LeadQualificationRun[]
  communicationSettings ResearchCommunicationSettings?
  recipients      ResearchRecipient[]
  attachments     ResearchAttachment[]
  testEmailSends  ResearchTestEmailSend[]

  @@map("researches")
}

/// Stage 01 result for one research job.
model ResearchStage01 {
  id                 String   @id @default(cuid())
  jobId              String   @unique
  job                Research @relation(fields: [jobId], references: [id], onDelete: Cascade)
  identifiedProduct  Json
  preparedCandidates Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("research_stage_01_results")
}

/// Full stage 02 result for one research job.
model ResearchStage02 {
  id        String   @id @default(cuid())
  jobId     String   @unique
  job       Research @relation(fields: [jobId], references: [id], onDelete: Cascade)
  result    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("research_stage_02_results")
}

/// Stage 03 result and resumable progress for one research job.
model ResearchStage03 {
  id            String   @id @default(cuid())
  jobId         String   @unique
  job           Research @relation(fields: [jobId], references: [id], onDelete: Cascade)
  criteria      Json?
  promptVersion String?
  /// Cumulative per-page decisions: every a, b, none, language exclusion and error.
  decisions     Json     @default("[]")
  decidedPages  Int      @default(0)
  errorPages    Int      @default(0)
  /// 03.2 result built from all final decisions; null until the first checkpoint.
  result        Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("research_stage_03_results")
}

/// Transport security of one mail connection. Unencrypted authentication is
/// deliberately not representable.
enum EmailSecurityMode {
  TLS
  STARTTLS
}

/// Outcome of the last saved-configuration connection test for one mail
/// protocol. `NOT_TESTED` also means that a configuration change invalidated an
/// earlier result.
enum EmailVerificationStatus {
  NOT_TESTED
  VERIFIED
  FAILED
}

/// One independently configurable mailbox. SMTP and IMAP credentials are
/// stored separately as authenticated ciphertext (AES-256-GCM, key from
/// `EMAIL_ACCOUNT_ENCRYPTION_KEY`); no plaintext credential is ever persisted
/// or returned. The verification fields below are independent per protocol:
/// changing one protocol's configuration resets only that protocol's result.
/// There is intentionally no relation to research yet.
///
/// The signature columns are an optional, reusable block that is composed into
/// every initial email sent through this account. `null` means the field is not
/// configured. They hold plain text only; the website and WhatsApp values are
/// validated HTTP(S) links and no rich-text markup is stored.
model EmailAccount {
  id           String  @id @default(cuid())
  name         String
  senderName   String
  emailAddress String
  enabled      Boolean @default(true)

  smtpHost              String
  smtpPort              Int
  smtpSecurity          EmailSecurityMode
  smtpUsername          String
  smtpPasswordEncrypted String

  imapHost              String
  imapPort              Int
  imapSecurity          EmailSecurityMode
  imapUsername          String
  imapPasswordEncrypted String

  /// Optional reusable signature block, rendered after the owner-authored
  /// message. Every field is optional; `signatureWebsite` and
  /// `signatureWhatsapp` hold a validated HTTP(S) link when present.
  signatureName     String?
  signatureCompany  String?
  signaturePhone    String?
  signatureWebsite  String?
  signatureWhatsapp String?
  signatureText     String?

  /// Result of the last SMTP connection test, never of a sending attempt.
  smtpVerificationStatus      EmailVerificationStatus @default(NOT_TESTED)
  smtpLastCheckedAt           DateTime?
  smtpVerificationFailureCode String?

  /// Result of the last IMAP connection test, never of a mailbox operation.
  imapVerificationStatus      EmailVerificationStatus @default(NOT_TESTED)
  imapLastCheckedAt           DateTime?
  imapVerificationFailureCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  researchCommunicationSettings ResearchCommunicationSettings[]

  @@map("email_accounts")
}

/// Research-specific communication configuration. Email-account selection is
/// independent of research execution and stores no credentials: the credentials
/// remain encrypted in `email_accounts`. A research without a saved row has no
/// explicit configuration; future communication settings belong to this model.
/// The account relation is restricted on delete so a still-assigned account is
/// never silently unassigned; disabling an account keeps the assignment intact.
///
/// The initial email is owner-authored plain text shared by every recipient.
/// `null` means not configured. The recipient-queue marker records which
/// published Stage 05 run the prepared queue was built from; it makes queue
/// preparation idempotent without a second state table.
model ResearchCommunicationSettings {
  researchId    String       @id
  research      Research     @relation(fields: [researchId], references: [id], onDelete: Cascade)
  emailAccountId String?
  emailAccount  EmailAccount? @relation(fields: [emailAccountId], references: [id], onDelete: Restrict)
  initialEmailSubject String?
  initialEmailBody    String?
  recipientQueueSourceRunId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([emailAccountId])
  @@map("research_communication_settings")
}

/// Why one mailbox was selected as the company's primary recipient. Derived
/// deterministically from published Stage 05 mailbox metadata; no employee
/// identity or position is inferred.
enum RecipientSelectionReason {
  /// A sales or commercial department mailbox.
  SALES_DEPARTMENT
  /// A general company mailbox such as info@ or office@.
  GENERAL_MAILBOX
  /// A suitable individual company-association mailbox.
  INDIVIDUAL_CONTACT
}

/// Lifecycle of one prepared recipient. V1 has exactly one value on purpose:
/// a prepared recipient is not eligible, authorized or sent, and no state may
/// claim otherwise. Sending eligibility, suppression and delivery outcomes
/// belong to separate future records.
enum RecipientQueueStatus {
  PREPARED
}

/// One prepared initial-email recipient per retained Stage 05 company.
///
/// The queue is derived, not sent: `status` is always `PREPARED` in V1. The
/// source publication run and Stage 05 result id preserve provenance. A newer
/// published run replaces the prepared set while no delivery history exists;
/// once sending is introduced, recipients with history must be preserved and
/// marked superseded instead of deleted. Alternative addresses are kept as the
/// future fallback input for delivery failures.
model ResearchRecipient {
  id                 String                  @id @default(cuid())
  researchId         String
  research           Research                @relation(fields: [researchId], references: [id], onDelete: Cascade)
  sourceRunId        String
  sourceResultId     String
  sourceCompanyIndex Int
  domain             String
  companyName        String?
  primaryEmail       String
  alternativeEmails  String[]                @default([])
  selectionReason    RecipientSelectionReason
  status             RecipientQueueStatus    @default(PREPARED)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([researchId, domain])
  @@unique([researchId, primaryEmail])
  @@index([researchId, status])
  @@map("research_recipients")
}

/// One private attachment of a research's initial email.
///
/// The attachment belongs to the research, not to the email account: the same
/// initial email is shared by every prepared recipient of that research. The
/// file bytes are stored in this row so metadata and content are written and
/// deleted atomically, survive an application restart and are covered by the
/// database backup. No HTTP route returns `content`; the API exposes metadata
/// only, so the file is never publicly readable and no filesystem path exists
/// that could be traversed. Size, count and total limits are enforced by the
/// API and configurable through `ATTACHMENT_*` environment variables.
model ResearchAttachment {
  id         String   @id @default(cuid())
  researchId String
  research   Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  /// The sanitised display name exactly as uploaded; never used as a path.
  filename   String
  mimeType   String
  sizeBytes  Int
  /// Lowercase hex SHA-256 of `content`; integrity metadata only.
  sha256     String
  content    Bytes
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([researchId, createdAt])
  @@map("research_attachments")
}

/// Outcome of one owner-triggered test email.
enum TestEmailSendStatus {
  SENT
  FAILED
}

/// One recorded test-send attempt. Test sends are deliberately separate from
/// first-contact communication: they never change a prepared recipient, never
/// count towards first-contact statistics and never trigger automatic
/// communication. The account and sender are stored as snapshots so the record
/// stays readable after an account edit; the message body and the attachment
/// bytes are not duplicated here.
///
/// `failureCode` and `failureMessage` are safe, enumerable values derived from
/// the transport result; raw provider responses and credentials are never
/// stored.
model ResearchTestEmailSend {
  id              String              @id @default(cuid())
  researchId      String
  research        Research            @relation(fields: [researchId], references: [id], onDelete: Cascade)
  emailAccountId  String
  senderEmail     String
  recipient       String
  subject         String
  attachmentCount Int                 @default(0)
  status          TestEmailSendStatus
  failureCode     String?
  failureMessage  String?
  createdAt       DateTime            @default(now())

  @@index([researchId, createdAt])
  @@map("research_test_email_sends")
}

/// One stored value per registered setting key. The code registry owns the
/// schema and the default; this table only holds values that were explicitly
/// saved. `value` stays JSON so new setting types need no migration.
model Setting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

enum LeadQualificationRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  INTERRUPTED
  FAILED
}

enum LeadQualificationTrigger {
  AUTO
  MANUAL
}

enum LeadQualificationDecision {
  ACCEPTED
  EXCLUDED
}

/// One independently executable Stage 05 qualification run. It consumes a
/// completed research result and never modifies the source research.
model LeadQualificationRun {
  id                        String                      @id @default(cuid())
  researchId                String
  research                  Research                    @relation(fields: [researchId], references: [id], onDelete: Cascade)
  status                    LeadQualificationRunStatus  @default(QUEUED)
  trigger                   LeadQualificationTrigger
  targetCountry             String
  qualificationVersion      String
  policyVersion             String
  promptVersion             String?
  inputFingerprint          String
  sourceResultSchemaVersion Int?
  companyCount              Int                         @default(0)
  processedCount            Int                         @default(0)
  acceptedCount             Int                         @default(0)
  excludedCount             Int                         @default(0)
  technicalFailureCount     Int                         @default(0)
  usage                     Json                        @default("{}")
  executionToken            String?
  executionLeaseUntil       DateTime?
  lastHeartbeatAt           DateTime?
  startedAt                 DateTime?
  completedAt               DateTime?
  publishedAt               DateTime?
  supersededAt              DateTime?
  error                     String?
  startKey                  String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  results                   LeadQualificationResult[]

  @@unique([researchId, startKey])
  @@index([researchId, createdAt])
  @@index([status, executionLeaseUntil])
  @@map("lead_qualification_runs")
}

/// Durable per-company Stage 05 result. Checks, contacts and evidence are
/// validated JSON payloads; decision and primary reason are scalar filters.
model LeadQualificationResult {
  id                     String                      @id @default(cuid())
  runId                  String
  run                    LeadQualificationRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceCompanyIndex     Int
  sourceCompanyKey       String
  domain                 String
  companyName            String?
  legalName              String?
  country                String?
  profileHash            String
  decision               LeadQualificationDecision
  primaryExclusionReason String?
  exclusionReasons       String[]                    @default([])
  technicalFailure       Boolean                     @default(false)
  checks                 Json
  contacts               Json
  evidenceSources        Json
  metadata               Json
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@unique([runId, sourceCompanyIndex])
  @@index([runId, decision])
  @@index([runId, primaryExclusionReason])
  @@map("lead_qualification_results")
}
