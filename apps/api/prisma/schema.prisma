// Prisma schema for the SDR Assistant API.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ResearchStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  INTERRUPTED
}

model Product {
  id                  String     @id @default(cuid())
  name                String
  description         String     @default("")
  possibleSearchTerms String[]   @default([])
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  research            Research[]

  @@map("products")
}

model Research {
  id              String         @id @default(cuid())
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  country         String
  status          ResearchStatus @default(QUEUED)
  stage           String?
  result          Json?
  error           String?
  lastHeartbeatAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("researches")
}

/// One stored value per registered setting key. The code registry owns the
/// schema and the default; this table only holds values that were explicitly
/// saved. `value` stays JSON so new setting types need no migration.
model Setting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}
