# PostgreSQL connection string used by the API and the Prisma CLI.
DATABASE_URL="postgresql://sdr:sdr@localhost:5433/sdr_assistant"

# Port the Fastify server listens on.
PORT=4000

# DeepSeek API key used by POST /research.
DEEPSEEK_API_KEY=

# Key that encrypts stored email-account credentials (AES-256-GCM).
# Exactly 32 random bytes, Base64-encoded. Generate one with:
#   node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64'))"
# There is no default and no plaintext fallback: creating or updating an email
# account fails safely while this is unset or invalid. Never commit the value.
EMAIL_ACCOUNT_ENCRYPTION_KEY=
